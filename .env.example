# Neon "main" branch, DIRECT connection string (no "-pooler" in host)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Better Auth: generate the secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Email: file (writes JSON to MAIL_OUTBOX_DIR) | resend | memory
MAIL_DRIVER="file"
MAIL_OUTBOX_DIR=".mail-outbox"
MAIL_FROM="Space Rental <no-reply@spacerental.rw>"
RESEND_API_KEY=""

RATE_LIMIT_ENABLED="true"
LOG_LEVEL="info"
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# .env.test (not committed) must contain:
# TEST_DATABASE_URL="<Neon 'test' branch DIRECT connection string>"

# Allow `pnpm db:seed` to load demo data. Set to "1" only for dev/test databases, never in production.
ALLOW_DEMO_SEED=""
# Optional: the demo host's password when seeding a shared/public database (defaults to the public demo password).
DEMO_HOST_PASSWORD=""

# Optional: your own hosted hero background video (MP4). Defaults to a free Mixkit demo clip.
NEXT_PUBLIC_HERO_VIDEO_URL=""
