# Neon "main" branch, DIRECT connection string (no "-pooler" in host)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Better Auth: generate the secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Email: file (writes JSON to MAIL_OUTBOX_DIR) | resend | memory
MAIL_DRIVER="file"
MAIL_OUTBOX_DIR=".mail-outbox"
MAIL_FROM="Space Rental <no-reply@spacerental.rw>"
RESEND_API_KEY=""

# "on" to require email verification for new accounts (needs working email, e.g. Resend). Default: off.
EMAIL_VERIFICATION="off"
RATE_LIMIT_ENABLED="true"
LOG_LEVEL="info"
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# .env.test (not committed) must contain:
# TEST_DATABASE_URL="<Neon 'test' branch DIRECT connection string>"

# Allow `pnpm db:seed` to load demo data. Set to "1" only for dev/test databases, never in production.
ALLOW_DEMO_SEED=""
# Optional: the demo host's password when seeding a shared/public database (defaults to the public demo password).
DEMO_HOST_PASSWORD=""

# Optional: your own hosted hero background video (MP4). Defaults to a free Mixkit demo clip.
NEXT_PUBLIC_HERO_VIDEO_URL=""

# Minutes an unpaid booking holds its dates (default 30).
# BOOKING_HOLD_MINUTES=30

# Host photo uploads (Cloudinary). Leave unset to keep uploads off.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Payments: shared secret for signed provider callbacks (see docs/payments.md). Unset = payments not connected.
# PAYMENT_WEBHOOK_SECRET=
# Background jobs: Vercel Cron sends this as a Bearer token.
# CRON_SECRET=
