generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  phone         String?
  locale        String     @default("en")
  role          Role       @default(USER)
  isHost        Boolean    @default(false)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sessions      Session[]
  accounts      Account[]
  listings      Listing[]
  favorites     Favorite[]
  bookings      Booking[]
  auditLogs     AuditLog[]
  questions     ListingQuestion[] @relation("asker")
  answers       ListingQuestion[] @relation("answerer")
  reviews       Review[]
  notifications Notification[]
  tickets       SupportTicket[]
  ticketMessages SupportMessage[]
  /// Code this person shares to invite friends (made when first needed).
  referralCode  String?        @unique
  /// Who invited this person (set once, never to themselves).
  referredById  String?
  referredBy    User?          @relation("referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals     User[]         @relation("referrals")
  rewardsEarned ReferralReward[] @relation("rewardReferrer")
  rewardFrom    ReferralReward?  @relation("rewardReferee")
  settlements   Settlement[]
  guestChats    Conversation[] @relation("chatGuest")
  hostChats     Conversation[] @relation("chatHost")
  messagesSent  Message[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

enum ListingType {
  APARTMENT
  DUPLEX
  PRIVATE_HOUSE
  LODGE
  ROOM
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum RateUnit {
  HOUR
  DAY
  NIGHT
  WEEK
  MONTH
  YEAR
}

enum Facility {
  KITCHEN
  WIFI
  AIR_CONDITIONER
  WORKPLACE
  WASHING_MACHINE
  DISHWASHER
  OVEN
  MICROWAVE
  PARKING
  TV
  HOT_WATER
  SECURITY
  GENERATOR
  POOL
}

model Listing {
  id              String        @id @default(cuid())
  hostId          String
  host            User          @relation(fields: [hostId], references: [id], onDelete: Cascade)
  title           String
  description     String
  type            ListingType
  status          ListingStatus @default(DRAFT)
  rejectionReason String?
  addressLine     String
  district        String
  city            String
  country         String        @default("RW")
  lat             Float
  lng             Float
  sizeM2          Int
  rooms           Int
  bedrooms        Int
  bathrooms       Int
  maxGuests       Int
  petsAllowed     Boolean       @default(false)
  facilities      Facility[]
  characteristics String[]
  termsOfRent     String[]
  depositMonths   Int?
  discountPercent Int?
  ratingAvg       Float         @default(0)
  ratingCount     Int           @default(0)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  photos          ListingPhoto[]
  rates           RateOption[]
  favoritedBy     Favorite[]
  bookings        Booking[]
  questions       ListingQuestion[]
  reviews         Review[]
  /// Whole place, single rooms, or either.
  bookingModel    BookingModel  @default(WHOLE_PROPERTY)
  roomUnits       Room[]
  conversations   Conversation[]

  @@index([status, city])
  @@index([hostId])
  @@map("listing")
}

model ListingPhoto {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  width     Int
  height    Int
  position  Int

  @@unique([listingId, position])
  @@map("listingPhoto")
}

model RateOption {
  id           String   @id @default(cuid())
  listingId    String
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  unit         RateUnit
  price        Int
  minUnits     Int      @default(1)
  maxUnits     Int?
  checkInTime  String?
  checkOutTime String?
  dayStartTime String?
  dayEndTime   String?

  @@unique([listingId, unit])
  @@map("rateOption")
}

model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, listingId])
  @@index([listingId])
  @@map("favorite")
}

/// PENDING_PAYMENT holds the dates until holdExpiresAt; only a verified payment moves it to CONFIRMED.
enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  EXPIRED
}

/// Overlapping active bookings of one listing are refused by the database (exclusion constraint "booking_no_overlap").
model Booking {
  id             String         @id @default(cuid())
  /// Short code shown to guests and on receipts, e.g. "SR-7K2M9Q".
  reference      String         @unique
  listingId      String
  listing        Listing        @relation(fields: [listingId], references: [id], onDelete: Restrict)
  guestId        String
  guest          User           @relation(fields: [guestId], references: [id], onDelete: Restrict)
  /// Set when one room is booked; null = the whole place.
  roomId         String?
  room           Room?          @relation(fields: [roomId], references: [id], onDelete: Restrict)
  status         BookingStatus  @default(PENDING_PAYMENT)
  checkIn        DateTime       @db.Date
  checkOut       DateTime       @db.Date
  /// How it was booked (hours, days, nights, weeks, months, years) and how many.
  unit           RateUnit       @default(NIGHT)
  quantity       Int            @default(1)
  /// Exact time the place is taken from and until (end not included); double booking is checked on these.
  startAt        DateTime
  endAt          DateTime
  nights         Int
  guests         Int
  /// Prices in whole RWF, worked out on the server when booked.
  nightlyPrice   Int
  /// nights × nightly price
  subtotal       Int            @default(0)
  /// Platform fee paid by the guest (from settings at booking time).
  guestFee       Int            @default(0)
  /// What the guest pays: subtotal + guestFee.
  total          Int
  /// Platform commission taken from the subtotal, and what the property owner is owed.
  commission     Int            @default(0)
  hostPayout     Int            @default(0)
  currency       String         @default("RWF")
  paymentMethod  String?
  /// Masked payer number ("078 ••• 4567"); the full number is not stored.
  payerPhone     String?
  /// What the guest saw and agreed to: check-in/out times, house rules, cancellation terms.
  policySnapshot Json
  holdExpiresAt  DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  events         BookingEvent[]
  review         Review?
  /// Nightly stay or monthly rental.
  rentalMode     RentalMode     @default(STAY)
  /// Monthly rentals: number of months, and months paid when booking.
  months         Int?
  upfrontMonths  Int?
  /// Monthly rentals: deposit due with the first payment.
  deposit        Int            @default(0)
  /// Promo code used and the discount it gave (and who funds it).
  promoCodeId    String?
  promoCode      PromoCode?     @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  discount       Int            @default(0)
  payments       Payment[]
  ledger         LedgerEntry[]
  referralReward ReferralReward?
  identity       BookingIdentity?

  @@index([guestId, checkIn])
  @@index([listingId, checkIn])
  @@map("booking")
}

/// Every status change of a booking: who, when, from what, to what, and why.
model BookingEvent {
  id         String         @id @default(cuid())
  bookingId  String
  booking    Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus BookingStatus?
  toStatus   BookingStatus
  actorId    String?
  reason     String?
  createdAt  DateTime       @default(now())

  @@index([bookingId, createdAt])
  @@map("bookingEvent")
}

/// Who did what to which record, kept for admins (publication, moderation, roles, support, bookings).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// e.g. "listing.approve", "question.answer", "ticket.status"
  action     String
  entityType String
  entityId   String
  data       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@map("auditLog")
}

/// Questions, feedback: nothing shows publicly until staff publish it.
enum ModerationStatus {
  PENDING
  PUBLISHED
  REJECTED
}

model ListingQuestion {
  id           String           @id @default(cuid())
  listingId    String
  listing      Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  askerId      String
  asker        User             @relation("asker", fields: [askerId], references: [id], onDelete: Cascade)
  question     String
  answer       String?
  answeredById String?
  answeredBy   User?            @relation("answerer", fields: [answeredById], references: [id], onDelete: SetNull)
  answeredAt   DateTime?
  status       ModerationStatus @default(PENDING)
  createdAt    DateTime         @default(now())

  @@index([listingId, status, createdAt])
  @@index([status, createdAt])
  @@map("listingQuestion")
}

/// Post-stay feedback: one per completed booking, published after moderation.
model Review {
  id        String           @id @default(cuid())
  bookingId String           @unique
  booking   Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  authorId  String
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  status    ModerationStatus @default(PENDING)
  createdAt DateTime         @default(now())

  @@index([listingId, status, createdAt])
  @@index([status, createdAt])
  @@map("review")
}

/// In-app notices; the text is written at display time in the reader's language from `kind` and `data`.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  data      Json
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("notification")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketCategory {
  QUESTION
  BOOKING
  PAYMENT
  COMPLAINT
  OTHER
}

model SupportTicket {
  id               String           @id @default(cuid())
  /// Short code shown to the customer, e.g. "HL-7K2M9Q".
  reference        String           @unique
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         TicketCategory
  subject          String
  bookingReference String?
  status           TicketStatus     @default(OPEN)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  messages         SupportMessage[]

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
  @@map("supportTicket")
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  fromStaff Boolean       @default(false)
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@map("supportMessage")
}

enum BookingModel {
  WHOLE_PROPERTY
  ROOM_BY_ROOM
  BOTH
}

/// AVAILABLE rooms can be booked; the others are blocked (repairs, not offered, being cleaned after a checkout).
enum RoomStatus {
  AVAILABLE
  MAINTENANCE
  UNAVAILABLE
  CLEANING
}

model Room {
  id           String     @id @default(cuid())
  listingId    String
  listing      Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  name         String
  description  String     @default("")
  maxGuests    Int
  facilities   Facility[]
  status       RoomStatus @default(AVAILABLE)
  rates        RoomRate[]
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  bookings     Booking[]

  @@index([listingId, position])
  @@map("room")
}

/// Business settings staff control (one row). Empty values mean "not set": nothing is charged or promised for them.
model PlatformConfig {
  id                    Int      @id @default(1)
  /// Basis points (100 = 1%) of the stay price kept by the platform.
  commissionBps         Int?
  /// Basis points added on top of the stay price for the guest.
  guestFeeBps           Int?
  /// Minutes an unpaid booking holds its dates (falls back to BOOKING_HOLD_MINUTES).
  holdMinutes           Int?
  /// Deposit for monthly rentals, percent of one month.
  monthlyDepositPercent Int?
  /// Cancellation terms shown before booking, per language: { en, fr, rw }.
  cancellationPolicy    Json?
  /// Monthly rentals: months paid when booking (null = monthly booking not offered yet).
  monthlyUpfrontMonths  Int?
  /// Identity details asked from monthly renters (only what the business approved).
  monthlyIdentity       IdentityRequirement @default(NONE)
  /// Referrals: on/off, and the reward (RWF) for the inviter after the friend's first finished stay (null = no reward).
  referralEnabled       Boolean  @default(false)
  referralRewardAmount  Int?
  updatedAt             DateTime @updatedAt
  updatedById           String?

  @@map("platformConfig")
}

enum RentalMode {
  STAY
  MONTHLY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

/// A payment attempt for a booking, as reported by the payment provider.
model Payment {
  id                String        @id @default(cuid())
  bookingId         String
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  provider          String
  /// The provider's transaction id: one payment per transaction, so a repeated callback can't pay twice.
  providerReference String?       @unique
  amount            Int
  currency          String        @default("RWF")
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([bookingId])
  @@map("payment")
}

/// Every provider callback received, keyed by the provider's event id: a repeat is recognised and ignored.
model PaymentEvent {
  id          String   @id
  provider    String
  type        String
  payload     Json
  outcome     String
  receivedAt  DateTime @default(now())

  @@map("paymentEvent")
}

enum LedgerKind {
  GUEST_PAYMENT
  GUEST_FEE
  COMMISSION
  HOST_PAYABLE
  DEPOSIT_HELD
  PROMO_DISCOUNT
  SETTLEMENT
  REFERRAL_REWARD
  REFUND
}

/// Money movements, never edited: the guest's payment, the platform's share, what owners are owed and paid.
model LedgerEntry {
  id           String      @id @default(cuid())
  kind         LedgerKind
  /// Positive amounts in RWF; the kind says which way the money goes.
  amount       Int
  currency     String      @default("RWF")
  bookingId    String?
  booking      Booking?    @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  hostId       String?
  settlementId String?
  settlement   Settlement? @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  note         String?
  createdAt    DateTime    @default(now())

  @@index([hostId, kind])
  @@index([bookingId])
  @@map("ledgerEntry")
}

enum SettlementStatus {
  PENDING
  PAID
}

/// A payout to a property owner, recorded by staff.
model Settlement {
  id                String           @id @default(cuid())
  reference         String           @unique
  hostId            String
  host              User             @relation(fields: [hostId], references: [id], onDelete: Restrict)
  amount            Int
  currency          String           @default("RWF")
  status            SettlementStatus @default(PAID)
  method            String?
  externalReference String?
  createdById       String
  createdAt         DateTime         @default(now())
  entries           LedgerEntry[]

  @@index([hostId, createdAt])
  @@map("settlement")
}

enum PromoFunding {
  PLATFORM
  HOST
}

model PromoCode {
  id          String       @id @default(cuid())
  code        String       @unique
  description String       @default("")
  percentOff  Int?
  amountOff   Int?
  minSubtotal Int?
  startsAt    DateTime?
  endsAt      DateTime?
  maxUses     Int?
  usedCount   Int          @default(0)
  /// Who pays for the discount: the platform (owner still gets the full price) or the owner.
  fundedBy    PromoFunding @default(PLATFORM)
  active      Boolean      @default(true)
  createdById String
  createdAt   DateTime     @default(now())
  bookings    Booking[]

  @@map("promoCode")
}

enum RewardStatus {
  PENDING
  APPROVED
  VOID
}

/// A referral reward waiting for staff approval; one per invited person, only after their first finished stay.
model ReferralReward {
  id         String       @id @default(cuid())
  referrerId String
  referrer   User         @relation("rewardReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId  String       @unique
  referee    User         @relation("rewardReferee", fields: [refereeId], references: [id], onDelete: Cascade)
  bookingId  String       @unique
  booking    Booking      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  amount     Int
  status     RewardStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  decidedAt  DateTime?

  @@map("referralReward")
}

enum IdentityRequirement {
  NONE
  ID
  ID_NATIONALITY
}

/// Identity details for a monthly rental, kept apart from the booking; staff only.
model BookingIdentity {
  bookingId   String   @id
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  idNumber    String
  nationality String?
  createdAt   DateTime @default(now())

  @@map("bookingIdentity")
}

/// A guest's chat with a place's host (one per guest and place).
model Conversation {
  id            String    @id @default(cuid())
  listingId     String
  listing       Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  guestId       String
  guest         User      @relation("chatGuest", fields: [guestId], references: [id], onDelete: Cascade)
  hostId        String
  host          User      @relation("chatHost", fields: [hostId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime  @default(now())
  guestReadAt   DateTime?
  hostReadAt    DateTime?
  createdAt     DateTime  @default(now())
  messages      Message[]

  @@unique([listingId, guestId])
  @@index([guestId, lastMessageAt])
  @@index([hostId, lastMessageAt])
  @@map("conversation")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("message")
}

/// A room's own price for one way of booking it (by the hour, night, week…).
model RoomRate {
  id     String   @id @default(cuid())
  roomId String
  room   Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  unit   RateUnit
  price  Int

  @@unique([roomId, unit])
  @@map("roomRate")
}
