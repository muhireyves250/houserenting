generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  phone         String?
  locale        String     @default("en")
  role          Role       @default(USER)
  isHost        Boolean    @default(false)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sessions      Session[]
  accounts      Account[]
  listings      Listing[]
  favorites     Favorite[]
  bookings      Booking[]
  auditLogs     AuditLog[]
  questions     ListingQuestion[] @relation("asker")
  answers       ListingQuestion[] @relation("answerer")
  reviews       Review[]
  notifications Notification[]
  tickets       SupportTicket[]
  ticketMessages SupportMessage[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

enum ListingType {
  APARTMENT
  DUPLEX
  PRIVATE_HOUSE
  LODGE
  ROOM
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum RateUnit {
  HOUR
  DAY
  NIGHT
  MONTH
}

enum Facility {
  KITCHEN
  WIFI
  AIR_CONDITIONER
  WORKPLACE
  WASHING_MACHINE
  DISHWASHER
  OVEN
  MICROWAVE
  PARKING
  TV
  HOT_WATER
  SECURITY
  GENERATOR
  POOL
}

model Listing {
  id              String        @id @default(cuid())
  hostId          String
  host            User          @relation(fields: [hostId], references: [id], onDelete: Cascade)
  title           String
  description     String
  type            ListingType
  status          ListingStatus @default(DRAFT)
  rejectionReason String?
  addressLine     String
  district        String
  city            String
  country         String        @default("RW")
  lat             Float
  lng             Float
  sizeM2          Int
  rooms           Int
  bedrooms        Int
  bathrooms       Int
  maxGuests       Int
  petsAllowed     Boolean       @default(false)
  facilities      Facility[]
  characteristics String[]
  termsOfRent     String[]
  depositMonths   Int?
  discountPercent Int?
  ratingAvg       Float         @default(0)
  ratingCount     Int           @default(0)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  photos          ListingPhoto[]
  rates           RateOption[]
  favoritedBy     Favorite[]
  bookings        Booking[]
  questions       ListingQuestion[]
  reviews         Review[]

  @@index([status, city])
  @@index([hostId])
  @@map("listing")
}

model ListingPhoto {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  width     Int
  height    Int
  position  Int

  @@unique([listingId, position])
  @@map("listingPhoto")
}

model RateOption {
  id           String   @id @default(cuid())
  listingId    String
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  unit         RateUnit
  price        Int
  minUnits     Int      @default(1)
  maxUnits     Int?
  checkInTime  String?
  checkOutTime String?
  dayStartTime String?
  dayEndTime   String?

  @@unique([listingId, unit])
  @@map("rateOption")
}

model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, listingId])
  @@index([listingId])
  @@map("favorite")
}

/// PENDING_PAYMENT holds the dates until holdExpiresAt; only a verified payment moves it to CONFIRMED.
enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  EXPIRED
}

/// Overlapping active bookings of one listing are refused by the database (exclusion constraint "booking_no_overlap").
model Booking {
  id             String         @id @default(cuid())
  /// Short code shown to guests and on receipts, e.g. "SR-7K2M9Q".
  reference      String         @unique
  listingId      String
  listing        Listing        @relation(fields: [listingId], references: [id], onDelete: Restrict)
  guestId        String
  guest          User           @relation(fields: [guestId], references: [id], onDelete: Restrict)
  status         BookingStatus  @default(PENDING_PAYMENT)
  checkIn        DateTime       @db.Date
  checkOut       DateTime       @db.Date
  nights         Int
  guests         Int
  /// Prices in whole RWF, worked out on the server when booked.
  nightlyPrice   Int
  total          Int
  currency       String         @default("RWF")
  paymentMethod  String?
  /// Masked payer number ("078 ••• 4567"); the full number is not stored.
  payerPhone     String?
  /// What the guest saw and agreed to: check-in/out times, house rules, cancellation terms.
  policySnapshot Json
  holdExpiresAt  DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  events         BookingEvent[]
  review         Review?

  @@index([guestId, checkIn])
  @@index([listingId, checkIn])
  @@map("booking")
}

/// Every status change of a booking: who, when, from what, to what, and why.
model BookingEvent {
  id         String         @id @default(cuid())
  bookingId  String
  booking    Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus BookingStatus?
  toStatus   BookingStatus
  actorId    String?
  reason     String?
  createdAt  DateTime       @default(now())

  @@index([bookingId, createdAt])
  @@map("bookingEvent")
}

/// Who did what to which record, kept for admins (publication, moderation, roles, support, bookings).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// e.g. "listing.approve", "question.answer", "ticket.status"
  action     String
  entityType String
  entityId   String
  data       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@map("auditLog")
}

/// Questions, feedback: nothing shows publicly until staff publish it.
enum ModerationStatus {
  PENDING
  PUBLISHED
  REJECTED
}

model ListingQuestion {
  id           String           @id @default(cuid())
  listingId    String
  listing      Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  askerId      String
  asker        User             @relation("asker", fields: [askerId], references: [id], onDelete: Cascade)
  question     String
  answer       String?
  answeredById String?
  answeredBy   User?            @relation("answerer", fields: [answeredById], references: [id], onDelete: SetNull)
  answeredAt   DateTime?
  status       ModerationStatus @default(PENDING)
  createdAt    DateTime         @default(now())

  @@index([listingId, status, createdAt])
  @@index([status, createdAt])
  @@map("listingQuestion")
}

/// Post-stay feedback: one per completed booking, published after moderation.
model Review {
  id        String           @id @default(cuid())
  bookingId String           @unique
  booking   Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  authorId  String
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  status    ModerationStatus @default(PENDING)
  createdAt DateTime         @default(now())

  @@index([listingId, status, createdAt])
  @@index([status, createdAt])
  @@map("review")
}

/// In-app notices; the text is written at display time in the reader's language from `kind` and `data`.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  data      Json
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("notification")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketCategory {
  QUESTION
  BOOKING
  PAYMENT
  COMPLAINT
  OTHER
}

model SupportTicket {
  id               String           @id @default(cuid())
  /// Short code shown to the customer, e.g. "HL-7K2M9Q".
  reference        String           @unique
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         TicketCategory
  subject          String
  bookingReference String?
  status           TicketStatus     @default(OPEN)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  messages         SupportMessage[]

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
  @@map("supportTicket")
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  fromStaff Boolean       @default(false)
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@map("supportMessage")
}
